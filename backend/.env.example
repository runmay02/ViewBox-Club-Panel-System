PROJECT_NAME="ViewBox Club Panel System"
API_V1_STR="/api/v1"
SECRET_KEY="viewbox-development-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite for local development (supports SQLite WAL mode and PostgreSQL compatibility)
DATABASE_URL="sqlite:///./viewbox.db"

# Environment: development / production / testing
ENVIRONMENT="development"
DEBUG=True

# Default Mock OTP for deterministic development / testing
MOCK_OTP_DEFAULT="123456"
OTP_EXPIRY_MINUTES=5

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
